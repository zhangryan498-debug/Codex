{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "summary",
    "release_decision",
    "images",
    "issues",
    "previous_report_sha256",
    "rechecks",
    "target_gaps",
    "coverage_status",
    "target_assessments"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.4"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "release_decision": {
      "type": "string",
      "enum": [
        "not_authorized"
      ]
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "image_id",
          "image_file",
          "read_status",
          "observation",
          "uncertainties"
        ],
        "properties": {
          "image_id": {
            "type": "string",
            "minLength": 1
          },
          "image_file": {
            "type": "string",
            "minLength": 1
          },
          "read_status": {
            "type": "string",
            "enum": [
              "read",
              "unreadable",
              "not_read"
            ]
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "uncertainties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "image_id",
          "image_file",
          "original_text",
          "basis",
          "severity",
          "action",
          "repair_copy",
          "retest_status",
          "resolution_status",
          "fact_verification_status",
          "fact_basis",
          "fact_subject",
          "fact_scope",
          "resolution_basis_type",
          "fact_evidence_type",
          "unsupported_claim_present",
          "resolved_parts",
          "unresolved_parts",
          "target_id",
          "repair_object",
          "finding_type",
          "claim_present",
          "severity_basis",
          "impact"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "minLength": 1
          },
          "image_id": {
            "type": "string",
            "minLength": 1
          },
          "image_file": {
            "type": "string",
            "minLength": 1
          },
          "original_text": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "repair_copy": {
            "type": "string",
            "minLength": 1
          },
          "retest_status": {
            "type": "string",
            "enum": [
              "pending",
              "blocked",
              "not_applicable"
            ]
          },
          "resolution_status": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "partial",
              "unknown"
            ]
          },
          "fact_verification_status": {
            "type": "string",
            "enum": [
              "verified",
              "unverified",
              "contradicted",
              "not_applicable"
            ]
          },
          "fact_basis": {
            "type": "string",
            "minLength": 1
          },
          "fact_subject": {
            "type": "string",
            "minLength": 1
          },
          "fact_scope": {
            "type": "string",
            "enum": [
              "image_content",
              "provided_information",
              "real_world_claim",
              "not_applicable"
            ]
          },
          "resolution_basis_type": {
            "type": "string",
            "enum": [
              "claim_removed",
              "claim_corrected",
              "other"
            ]
          },
          "fact_evidence_type": {
            "type": "string",
            "enum": [
              "missing",
              "direct_image",
              "user_confirmed",
              "document",
              "not_applicable"
            ]
          },
          "unsupported_claim_present": {
            "type": "boolean"
          },
          "resolved_parts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "unresolved_parts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "repair_object": {
            "type": "string",
            "enum": [
              "copy_compliance",
              "fact_confirmation"
            ]
          },
          "finding_type": {
            "type": "string",
            "enum": [
              "provided_conflict",
              "mandatory_evidence_missing",
              "presentation_defect"
            ]
          },
          "claim_present": {
            "type": "boolean"
          },
          "severity_basis": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "enum": [
              "critical_transaction",
              "high_risk_claim",
              "material_information",
              "minor_presentation"
            ]
          }
        }
      }
    },
    "previous_report_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "rechecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "previous_issue_id",
          "image_id",
          "image_file",
          "current_text",
          "evidence",
          "basis",
          "action",
          "resolution_status",
          "fact_verification_status",
          "fact_basis",
          "fact_subject",
          "fact_scope",
          "resolution_basis_type",
          "fact_evidence_type",
          "unsupported_claim_present",
          "resolved_parts",
          "unresolved_parts",
          "target_id",
          "repair_object"
        ],
        "properties": {
          "previous_issue_id": {
            "type": "string",
            "minLength": 1
          },
          "image_id": {
            "type": "string",
            "minLength": 1
          },
          "image_file": {
            "type": "string",
            "minLength": 1
          },
          "current_text": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "resolution_status": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "partial",
              "unknown"
            ]
          },
          "fact_verification_status": {
            "type": "string",
            "enum": [
              "verified",
              "unverified",
              "contradicted",
              "not_applicable"
            ]
          },
          "fact_basis": {
            "type": "string",
            "minLength": 1
          },
          "fact_subject": {
            "type": "string",
            "minLength": 1
          },
          "fact_scope": {
            "type": "string",
            "enum": [
              "image_content",
              "provided_information",
              "real_world_claim",
              "not_applicable"
            ]
          },
          "resolution_basis_type": {
            "type": "string",
            "enum": [
              "claim_removed",
              "claim_corrected",
              "other"
            ]
          },
          "fact_evidence_type": {
            "type": "string",
            "enum": [
              "missing",
              "direct_image",
              "user_confirmed",
              "document",
              "not_applicable"
            ]
          },
          "unsupported_claim_present": {
            "type": "boolean"
          },
          "resolved_parts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "unresolved_parts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "repair_object": {
            "type": "string",
            "enum": [
              "copy_compliance",
              "fact_confirmation"
            ]
          }
        }
      }
    },
    "target_gaps": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "image_ids",
          "subject",
          "reason"
        ],
        "properties": {
          "image_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "coverage_status": {
      "type": "string",
      "enum": [
        "complete",
        "partial"
      ]
    },
    "target_assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "status",
          "basis"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "consistent",
              "contradicted",
              "uncertain",
              "not_assessed"
            ]
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "Model assessment of the fixed proposition, not repair obligation aggregation. System derives obligations independently."
    }
  }
}
